PORT=5000
MODE=development
APP_NAME="MARCOS"
APP_VERSION="1.0.0"
DATABASE_URL="postgresql://user:password@localhost:5432/marcos_db?sslmode=require"
REDIS_URL="redis://default:password@localhost:6379"
JWT_ACCESS_SECRET="your-jwt-access-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
CLOUDFLARE_R2_ACCESS_KEY="your-r2-access-key"
CLOUDFLARE_R2_SECRET_KEY="your-r2-secret-key"
CLOUDFLARE_R2_BUCKET="marcos-uploads"
CLOUDFLARE_R2_ENDPOINT="https://your-r2-endpoint.cloudflarestorage.com"
SENDGRID_API_KEY="your-sendgrid-api-key"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
ENCRYPTION_KEY="your-32-character-encryption-key"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM="MARCOS Studio <your-email@example.com>"

CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
